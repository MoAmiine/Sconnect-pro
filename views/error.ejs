<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Erreur <%= statusCode %> — SportConnect Pro</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="error-page">
  <div class="error-card">
    <div class="error-code"><%= statusCode %></div>
    <h1><%= statusCode === 404 ? "Page introuvable" : "Erreur serveur" %></h1>
    <p><%= message || "Une erreur est survenue." %></p>
    <a href="/" class="btn btn-primary">Retour au tableau de bord</a>
  </div>
</body>
</html>