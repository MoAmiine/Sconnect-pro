<%- include('../partials/header', { title: 'Activités', active: 'activities' }) %>

<h1>Catalogue d'activités</h1>
<p class="lede">Créneaux planifiés dans les infrastructures municipales.</p>

<%- include('../partials/alerts') %>

<div class="panel">
  <h2>Ajouter une activité</h2>
  <form method="POST" action="/activities" class="form-grid">
    <label class="wide">Nom
      <input type="text" name="name" required>
    </label>
    <label>Association
      <select name="association_id" required>
        <% associations.forEach(a => { %><option value="<%= a.id %>"><%= a.name %></option><% }) %>
      </select>
    </label>
    <label>Infrastructure
      <select name="facility_id" required>
        <% facilities.forEach(f => { %><option value="<%= f.id %>"><%= f.name %> (ERP <%= f.erp_capacity %>)</option><% }) %>
      </select>
    </label>
    <label>Sous-zone (si divisible)
      <input type="text" name="sub_zone" placeholder="A, B, ou vide">
    </label>
    <label>Sport
      <input type="text" name="sport_type" required placeholder="Natation, Boxe...">
    </label>
    <label>Jour
      <select name="day_of_week" required>
        <option value="1">Lundi</option><option value="2">Mardi</option><option value="3">Mercredi</option>
        <option value="4">Jeudi</option><option value="5">Vendredi</option><option value="6">Samedi</option>
        <option value="0">Dimanche</option>
      </select>
    </label>
    <label>Heure de début
      <input type="time" name="start_time" required>
    </label>
    <label>Heure de fin
      <input type="time" name="end_time" required>
    </label>
    <label>Tarif de base (€)
      <input type="number" step="0.01" name="base_price" required>
    </label>
    <label>Capacité max
      <input type="number" name="max_capacity" required>
    </label>
    <label>Catégorie d'âge
      <input type="text" name="age_category" required placeholder="senior, benjamin, tous_publics...">
    </label>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Créer</button>
    </div>
  </form>
</div>

<div class="panel">
  <h2>Liste des activités</h2>
  <table class="data-table">
    <thead><tr><th>Nom</th><th>Salle</th><th>Jour</th><th>Horaire</th><th class="num">Capacité</th><th></th></tr></thead>
    <tbody>
      <% activities.forEach(a => { %>
      <tr>
        <td><%= a.name %></td>
        <td><%= a.facility_name %><% if (a.sub_zone) { %> (<%= a.sub_zone %>)<% } %></td>
        <td><%= a.day_of_week %></td>
        <td class="num"><%= a.start_time %>–<%= a.end_time %></td>
        <td class="num"><%= a.max_capacity %></td>
        <td class="actions">
          <form method="POST" action="/activities/<%= a.id %>/delete">
            <button type="submit" class="btn-link-danger" onclick="return confirm('Supprimer ?')">Supprimer</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (activities.length === 0) { %><tr><td colspan="6" class="empty">Aucune activité planifiée.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>