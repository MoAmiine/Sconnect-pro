<%- include('../partials/header', { title: 'Activités', active: 'activities', heroTitle: "Catalogue d'activités", heroText: "Créneaux planifiés dans les infrastructures municipales." }) %>

<%- include('../partials/alerts') %>

<details class="panel">
  <summary>Ajouter une activité</summary>
  <form method="POST" action="/activities" class="form-grid">
    <label class="wide">Nom<input type="text" name="name" required></label>
    <label>Association
      <select name="association_id" required><% associations.forEach(a => { %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select>
    </label>
    <label>Infrastructure
      <select name="facility_id" required><% facilities.forEach(f => { %><option value="<%= f.id %>"><%= f.name %> (ERP <%= f.erp_capacity %>)</option><% }) %></select>
    </label>
    <label>Sous-zone (si divisible)<input type="text" name="sub_zone" placeholder="A, B, ou vide"></label>
    <label>Sport<input type="text" name="sport_type" required placeholder="Natation, Boxe..."></label>
    <label>Jour
      <select name="day_of_week" required>
        <option value="1">Lundi</option><option value="2">Mardi</option><option value="3">Mercredi</option>
        <option value="4">Jeudi</option><option value="5">Vendredi</option><option value="6">Samedi</option>
        <option value="0">Dimanche</option>
      </select>
    </label>
    <label>Heure de début<input type="time" name="start_time" required></label>
    <label>Heure de fin<input type="time" name="end_time" required></label>
    <label>Tarif de base (€)<input type="number" step="0.01" name="base_price" required></label>
    <label>Capacité max<input type="number" name="max_capacity" required></label>
    <label>Catégorie d'âge<input type="text" name="age_category" required placeholder="senior, benjamin, tous_publics..."></label>
    <div class="form-actions"><button type="submit" class="btn btn-primary">Créer</button></div>
  </form>
</details>

<div class="card-grid">
  <% activities.forEach(a => { %>
  <div class="card">
    <span class="card-tag"><%= a.sport_type %></span>
    <h3><%= a.name %></h3>
    <p class="meta"><%= a.facility_name %><% if (a.sub_zone) { %> (<%= a.sub_zone %>)<% } %></p>
    <p class="meta">Jour <%= a.day_of_week %> · <%= a.start_time %>–<%= a.end_time %> · <%= a.max_capacity %> places</p>
    <div class="card-actions">
      <a href="/activities/<%= a.id %>">Voir &amp; inscrire</a>
      <form method="POST" action="/activities/<%= a.id %>/delete">
        <button type="submit" class="btn-link-danger" onclick="return confirm('Supprimer ?')">Supprimer</button>
      </form>
    </div>
  </div>
  <% }) %>
  <% if (activities.length === 0) { %><p class="lede">Aucune activité planifiée.</p><% } %>
</div>

<%- include('../partials/footer') %>