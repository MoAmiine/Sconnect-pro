<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Activités</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <h1>Catalogue d'activités</h1>

  <% if (error) { %>
    <div style="background:#fdd;border:1px solid red;padding:10px;margin-bottom:10px;">
      ⚠️ <%= error %>
    </div>
  <% } %>

  <h2>Ajouter une activité</h2>
  <form method="POST" action="/activities">
    <label>Nom : <input type="text" name="name" required></label><br>

    <label>Association :
      <select name="association_id" required>
        <% associations.forEach(a => { %>
          <option value="<%= a.id %>"><%= a.name %></option>
        <% }) %>
      </select>
    </label><br>

    <label>Infrastructure :
      <select name="facility_id" required>
        <% facilities.forEach(f => { %>
          <option value="<%= f.id %>"><%= f.name %> (ERP: <%= f.erp_capacity %>)</option>
        <% }) %>
      </select>
    </label><br>

    <label>Sous-zone (si terrain divisible) : <input type="text" name="sub_zone" placeholder="A, B, ou vide"></label><br>
    <label>Sport : <input type="text" name="sport_type" required placeholder="ex: Boxe, Natation..."></label><br>

    <label>Jour de la semaine :
      <select name="day_of_week" required>
        <option value="1">Lundi</option>
        <option value="2">Mardi</option>
        <option value="3">Mercredi</option>
        <option value="4">Jeudi</option>
        <option value="5">Vendredi</option>
        <option value="6">Samedi</option>
        <option value="0">Dimanche</option>
      </select>
    </label><br>

    <label>Heure de début : <input type="time" name="start_time" required></label><br>
    <label>Heure de fin : <input type="time" name="end_time" required></label><br>
    <label>Tarif de base (€) : <input type="number" step="0.01" name="base_price" required></label><br>
    <label>Capacité max : <input type="number" name="max_capacity" required></label><br>
    <label>Catégorie d'âge : <input type="text" name="age_category" required placeholder="ex: senior, tous_publics..."></label><br>

    <button type="submit">Créer</button>
  </form>

  <h2>Liste des activités</h2>
  <table border="1" cellpadding="6">
    <tr><th>Nom</th><th>Salle</th><th>Jour</th><th>Horaire</th><th>Capacité</th><th>Actions</th></tr>
    <% activities.forEach(a => { %>
    <tr>
      <td><%= a.name %></td>
      <td><%= a.facility_name %><% if (a.sub_zone) { %> (<%= a.sub_zone %>)<% } %></td>
      <td><%= a.day_of_week %></td>
      <td><%= a.start_time %> - <%= a.end_time %></td>
      <td><%= a.max_capacity %></td>
      <td>
        <form method="POST" action="/activities/<%= a.id %>/delete" style="display:inline">
          <button type="submit" onclick="return confirm('Supprimer ?')">Supprimer</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </table>
</body>
</html>