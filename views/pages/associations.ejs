<%- include('../partials/header', { title: 'Associations', active: 'associations', heroTitle: 'Associations partenaires', heroText: "Les clubs qui organisent des activités dans les infrastructures municipales." }) %>

<%- include('../partials/alerts') %>

<details class="panel">
  <summary><%= editingAssociation ? "Modifier l'association" : "Ajouter une association" %></summary>
  <form method="POST" action="<%= editingAssociation ? '/associations/' + editingAssociation.id + '/update' : '/associations' %>" class="form-grid">
    <label class="wide">Nom<input type="text" name="name" value="<%= editingAssociation ? editingAssociation.name : '' %>" required></label>
    <label>Email<input type="email" name="contact_email" value="<%= editingAssociation && editingAssociation.contact_email ? editingAssociation.contact_email : '' %>"></label>
    <label>Téléphone<input type="text" name="contact_phone" value="<%= editingAssociation && editingAssociation.contact_phone ? editingAssociation.contact_phone : '' %>"></label>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= editingAssociation ? "Mettre à jour" : "Créer" %></button>
      <% if (editingAssociation) { %><a href="/associations" class="btn btn-ghost">Annuler</a><% } %>
    </div>
  </form>
</details>

<div class="card-grid">
  <% associations.forEach(a => { %>
  <div class="card">
    <span class="card-tag">Club</span>
    <h3><%= a.name %></h3>
    <p class="meta"><%= a.contact_email || '—' %></p>
    <p class="meta"><%= a.contact_phone || '—' %></p>
    <div class="card-actions">
      <a href="/associations/<%= a.id %>/edit">Modifier</a>
      <form method="POST" action="/associations/<%= a.id %>/delete">
        <button type="submit" class="btn-link-danger" onclick="return confirm('Supprimer ?')">Supprimer</button>
      </form>
    </div>
  </div>
  <% }) %>
  <% if (associations.length === 0) { %><p class="lede">Aucune association enregistrée.</p><% } %>
</div>

<%- include('../partials/footer') %>