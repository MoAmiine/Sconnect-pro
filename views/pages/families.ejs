<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Familles</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <h1>Foyers fiscaux (familles)</h1>

  <h2><%= editingFamily ? "Modifier" : "Ajouter" %> une famille</h2>
  <form method="POST" action="<%= editingFamily ? '/families/' + editingFamily.id + '/update' : '/families' %>">
    <label>Nom du foyer : <input type="text" name="name" value="<%= editingFamily ? editingFamily.name : '' %>" required></label><br>
    <label>Quotient familial (€) : <input type="number" step="0.01" name="quotient_familial" value="<%= editingFamily ? editingFamily.quotient_familial : '' %>" required></label><br>
    <button type="submit"><%= editingFamily ? "Mettre à jour" : "Créer" %></button>
  </form>

  <h2>Liste des familles</h2>
  <table border="1" cellpadding="6">
    <tr><th>ID</th><th>Nom</th><th>QF</th><th>Actions</th></tr>
    <% families.forEach(f => { %>
    <tr>
      <td><%= f.id %></td>
      <td><%= f.name %></td>
      <td><%= f.quotient_familial %> €</td>
      <td>
        <a href="/families/<%= f.id %>/edit">Modifier</a>
        <form method="POST" action="/families/<%= f.id %>/delete" style="display:inline">
          <button type="submit" onclick="return confirm('Supprimer ?')">Supprimer</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </table>
</body>
</html>