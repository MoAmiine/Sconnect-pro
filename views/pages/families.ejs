<%- include('../partials/header', { title: 'Familles', active: 'families' }) %>

<h1>Foyers fiscaux</h1>
<p class="lede">Le quotient familial détermine la bourse municipale (Règle 1C).</p>

<%- include('../partials/alerts') %>

<div class="panel">
  <h2><%= editingFamily ? "Modifier la famille" : "Ajouter une famille" %></h2>
  <form method="POST" action="<%= editingFamily ? '/families/' + editingFamily.id + '/update' : '/families' %>" class="form-grid">
    <label>Nom du foyer
      <input type="text" name="name" value="<%= editingFamily ? editingFamily.name : '' %>" required>
    </label>
    <label>Quotient familial (€)
      <input type="number" step="0.01" name="quotient_familial" value="<%= editingFamily ? editingFamily.quotient_familial : '' %>" required>
    </label>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= editingFamily ? "Mettre à jour" : "Créer" %></button>
      <% if (editingFamily) { %><a href="/families" class="btn btn-ghost">Annuler</a><% } %>
    </div>
  </form>
</div>

<div class="panel">
  <h2>Liste des familles</h2>
  <table class="data-table">
    <thead><tr><th>Nom</th><th class="num">Quotient familial</th><th></th></tr></thead>
    <tbody>
      <% families.forEach(f => { %>
      <tr>
        <td><%= f.name %></td>
        <td class="num"><%= f.quotient_familial %> €</td>
        <td class="actions">
          <a href="/families/<%= f.id %>/edit">Modifier</a>
          <form method="POST" action="/families/<%= f.id %>/delete">
            <button type="submit" class="btn-link-danger" onclick="return confirm('Supprimer ?')">Supprimer</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (families.length === 0) { %><tr><td colspan="3" class="empty">Aucune famille enregistrée.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>