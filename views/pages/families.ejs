<%- include('../partials/header', { 
  title: 'Familles & Foyers', 
  active: 'families', 
  heroTitle: 'Foyers Fiscaux & Solidarité', 
  heroText: "Gestion des quotients familiaux (QF) pour l'attribution des bourses municipales et de la dégressivité fratrie." 
}) %>

<%- include('../partials/alerts') %>

<!-- Grille informative des barèmes municipaux -->
<div class="kpi-grid">
  <div class="kpi-card">
    <span class="kpi-label">Tranche 1 (QF &lt; 600 €)</span>
    <span class="kpi-value" style="color:var(--gold-dark);">-40%</span>
    <span class="kpi-sub">Réduction sociale maximale</span>
  </div>
  <div class="kpi-card">
    <span class="kpi-label">Tranche 2 (600 € à 900 €)</span>
    <span class="kpi-value" style="color:var(--gold);">-20%</span>
    <span class="kpi-sub">Aide municipale intermédiaire</span>
  </div>
  <div class="kpi-card">
    <span class="kpi-label">Dégressivité Fratrie</span>
    <span class="kpi-value" style="color:var(--stade-mid);">-15% / -30%</span>
    <span class="kpi-sub">Dès la 2e inscription du même foyer</span>
  </div>
</div>

<!-- Formulaire d'ajout / modification de famille -->
<details class="panel" <%= editingFamily ? 'open' : '' %>>
  <summary>
    <span><%= editingFamily ? "✏️ Modifier le foyer : " + editingFamily.name : "➕ Créer un nouveau foyer fiscal" %></span>
    <span class="summary-badge">Quotient familial certifié CAF</span>
  </summary>
  <form method="POST" action="<%= editingFamily ? '/families/' + editingFamily.id + '/update' : '/families' %>" class="form-grid">
    <label>Nom de famille / Foyer
      <input type="text" name="name" value="<%= editingFamily ? editingFamily.name : '' %>" placeholder="Ex: Famille Dupont" required>
    </label>
    <label>Quotient Familial mensuel (€)
      <input type="number" step="0.01" min="0" name="quotient_familial" value="<%= editingFamily ? editingFamily.quotient_familial : '' %>" placeholder="Ex: 580.00" required>
    </label>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">
        <%= editingFamily ? "Mettre à jour le foyer" : "Enregistrer le foyer" %>
      </button>
      <% if (editingFamily) { %>
        <a href="/families" class="btn btn-ghost">Annuler</a>
      <% } %>
    </div>
  </form>
</details>

<!-- Table des familles -->
<div class="panel">
  <div class="panel-header">
    <h2><span class="icon">👨‍👩‍👧‍👦</span> Registre des Foyers Fiscaux</h2>
    <span class="badge badge-info"><%= families.length %> foyer(s) enregistré(s)</span>
  </div>

  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Nom du foyer</th>
          <th class="num">Quotient Familial (QF)</th>
          <th>Taux de Bourse Applicable</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% families.forEach(f => { %>
        <% const qf = parseFloat(f.quotient_familial); %>
        <tr>
          <td>
            <strong><%= f.name %></strong>
          </td>
          <td class="num">
            <%= Number(f.quotient_familial).toFixed(2) %> €
          </td>
          <td>
            <% if (qf < 600) { %>
              <span class="badge badge-gold">Tranche 1 (-40%)</span>
            <% } else if (qf <= 900) { %>
              <span class="badge badge-warning">Tranche 2 (-20%)</span>
            <% } else { %>
              <span class="badge badge-info">Standard (0%)</span>
            <% } %>
          </td>
          <td class="actions">
            <a href="/families/<%= f.id %>/edit" class="btn-link-edit">
              ✏️ Modifier
            </a>
            <form method="POST" action="/families/<%= f.id %>/delete">
              <button type="submit" class="btn-link-danger" onclick="return confirm('Confirmer la suppression de ce foyer ?')">
                🗑️ Supprimer
              </button>
            </form>
          </td>
        </tr>
        <% }) %>

        <% if (families.length === 0) { %>
          <tr>
            <td colspan="4" class="empty">Aucun foyer fiscal enregistré.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>