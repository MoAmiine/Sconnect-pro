<%- include('../partials/header', { title: 'Infrastructures', active: 'facilities', heroTitle: 'Infrastructures municipales', heroText: "Gymnases, bassins et dojos mis à disposition des associations partenaires." }) %>

<%- include('../partials/alerts') %>

<details class="panel">
  <summary><%= editingFacility ? "Modifier l'infrastructure" : "Ajouter une infrastructure" %></summary>
  <form method="POST" action="<%= editingFacility ? '/facilities/' + editingFacility.id + '/update' : '/facilities' %>" class="form-grid">
    <label>Nom<input type="text" name="name" value="<%= editingFacility ? editingFacility.name : '' %>" required></label>
    <label>Type<input type="text" name="type" value="<%= editingFacility ? editingFacility.type : '' %>" placeholder="gymnase, bassin, dojo..." required></label>
    <label class="wide">Adresse<input type="text" name="address" value="<%= editingFacility && editingFacility.address ? editingFacility.address : '' %>"></label>
    <label>Capacité ERP<input type="number" name="erp_capacity" value="<%= editingFacility ? editingFacility.erp_capacity : '' %>" required></label>
    <label class="checkbox"><input type="checkbox" name="is_divisible" <%= editingFacility && editingFacility.is_divisible ? 'checked' : '' %>> Infrastructure divisible (demi-terrains)</label>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= editingFacility ? "Mettre à jour" : "Créer" %></button>
      <% if (editingFacility) { %><a href="/facilities" class="btn btn-ghost">Annuler</a><% } %>
    </div>
  </form>
</details>

<div class="card-grid">
  <% facilities.forEach(f => { %>
  <div class="card">
    <span class="card-tag"><%= f.type %></span>
    <h3><%= f.name %></h3>
    <p class="meta"><%= f.address || 'Adresse non renseignée' %></p>
    <p class="meta">Capacité ERP : <strong><%= f.erp_capacity %></strong><% if (f.is_divisible) { %> · divisible<% } %></p>
    <div class="card-actions">
      <a href="/facilities/<%= f.id %>/edit">Modifier</a>
      <form method="POST" action="/facilities/<%= f.id %>/delete">
        <button type="submit" class="btn-link-danger" onclick="return confirm('Supprimer ?')">Supprimer</button>
      </form>
    </div>
  </div>
  <% }) %>
  <% if (facilities.length === 0) { %><p class="lede">Aucune infrastructure enregistrée pour le moment.</p><% } %>
</div>

<%- include('../partials/footer') %>