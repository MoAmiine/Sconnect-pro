<%- include('../partials/header', { 
  title: 'Tableau de bord', 
  active: 'dashboard', 
  heroTitle: 'Tableau de Bord Métropolitain', 
  heroText: "Supervision en temps réel des infrastructures, des recettes municipales et du remplissage des créneaux sportifs." 
}) %>

<%- include('../partials/alerts') %>

<div class="kpi-grid">
  <div class="kpi-card">
    <span class="kpi-label">Taux de Remplissage</span>
    <span class="kpi-value"><%= typeof stats !== 'undefined' ? stats.fillRate : 0 %>%</span>
    <span class="kpi-sub"><%= typeof stats !== 'undefined' ? stats.totalRegistrations : 0 %> places confirmées</span>
  </div>
  <div class="kpi-card">
    <span class="kpi-label">Recettes Saison</span>
    <span class="kpi-value" style="color:var(--gold-dark);"><%= typeof stats !== 'undefined' ? stats.totalRevenue.toFixed(2) : '0.00' %> €</span>
    <span class="kpi-sub">Total encaissé / engagé</span>
  </div>
  <div class="kpi-card">
    <span class="kpi-label">En File d'Attente</span>
    <span class="kpi-value" style="color:var(--info);"><%= typeof stats !== 'undefined' ? stats.totalWaiting : 0 %></span>
    <span class="kpi-sub">Candidats en attente de place</span>
  </div>
  <div class="kpi-card">
    <span class="kpi-label">Écosystème Sportif</span>
    <span class="kpi-value"><%= typeof stats !== 'undefined' ? stats.totalActivities : 0 %></span>
    <span class="kpi-sub"><%= typeof stats !== 'undefined' ? stats.totalFacilities : 0 %> salles · <%= typeof stats !== 'undefined' ? stats.totalAssociations : 0 %> clubs</span>
  </div>
</div>

<% if (typeof topActivities !== 'undefined' && topActivities.length > 0) { %>
<div class="panel" style="margin-bottom:28px;">
  <div class="panel-header">
    <h2><span class="icon">🔥</span> Affluence & Tension sur les Créneaux</h2>
    <span class="badge badge-gold">Activités les plus demandées</span>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Activité</th>
          <th>Discipline</th>
          <th>Infrastructure</th>
          <th>Inscrits / Jauge</th>
          <th style="text-align:right;">Taux</th>
        </tr>
      </thead>
      <tbody>
        <% topActivities.forEach(act => { %>
        <% const count = parseInt(act.confirmed_count, 10) || 0; %>
        <% const rate = Math.round((count / act.max_capacity) * 100); %>
        <tr>
          <td><strong><%= act.name %></strong></td>
          <td><span class="card-tag"><%= act.sport_type %></span></td>
          <td><%= act.facility_name %></td>
          <td class="num"><%= count %> / <%= act.max_capacity %></td>
          <td style="text-align:right;">
            <% if (rate >= 100) { %>
              <span class="badge badge-danger">Complet (100%)</span>
            <% } else if (rate >= 80) { %>
              <span class="badge badge-warning"><%= rate %>%</span>
            <% } else { %>
              <span class="badge badge-ok"><%= rate %>%</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<div class="panel">
  <div class="panel-header">
    <h2><span class="icon">🏆</span> Modules de Gestion Sportive</h2>
  </div>
  <div class="card-grid" style="margin-bottom:0;">
    <a href="/facilities" class="card">
      <div class="card-header-line">
        <span class="card-tag tag-facility">Équipements</span>
        <span class="badge badge-info">Jauges ERP</span>
      </div>
      <h3>Infrastructures</h3>
      <p class="meta">Gestion des salles, jauges incendie strictes et divisibilité des terrains.</p>
      <div class="card-actions">
        <span>Gérer les salles &rarr;</span>
      </div>
    </a>

    <a href="/associations" class="card">
      <div class="card-header-line">
        <span class="card-tag">Partenaires</span>
        <span class="badge badge-ok">Conventionnées</span>
      </div>
      <h3>Associations</h3>
      <p class="meta">Clubs résidents délégataires et organisateurs des activités municipales.</p>
      <div class="card-actions">
        <span>Voir les associations &rarr;</span>
      </div>
    </a>

    <a href="/activities" class="card">
      <div class="card-header-line">
        <span class="card-tag">Planning</span>
        <span class="badge badge-gold">Anti-collision</span>
      </div>
      <h3>Activités & Créneaux</h3>
      <p class="meta">Catalogue complet, contrôles des créneaux horaires et inscriptions en direct.</p>
      <div class="card-actions">
        <span>Ouvrir le catalogue &rarr;</span>
      </div>
    </a>

    <a href="/members" class="card">
      <div class="card-header-line">
        <span class="card-tag">Licenciés</span>
        <span class="badge badge-ok">Médical & Âge</span>
      </div>
      <h3>Registre Adhérents</h3>
      <p class="meta">Calcul automatique des catégories officielles au 31/12 et conformité des certificats.</p>
      <div class="card-actions">
        <span>Consulter le registre &rarr;</span>
      </div>
    </a>

    <a href="/families" class="card">
      <div class="card-header-line">
        <span class="card-tag">Solidarité</span>
        <span class="badge badge-warning">QF & Fratrie</span>
      </div>
      <h3>Foyers & Familles</h3>
      <p class="meta">Quotients familiaux pour bourse municipale et dégressivité fratrie (-15%, -30%).</p>
      <div class="card-actions">
        <span>Gérer les foyers &rarr;</span>
      </div>
    </a>
  </div>
</div>

<%- include('../partials/footer') %>